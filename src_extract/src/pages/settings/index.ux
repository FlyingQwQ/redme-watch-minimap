<template>
  <div class="settings-root">
    <scroll class="settings-scroll" scroll-y="true">
      <div class="settings-body">
        <div class="back" onclick="goBack"><text class="back-text">‹ 返回地图</text></div>
        <text class="title">地图设置</text>

        <text class="section">地图来源</text>
        <div class="card">
          <div class="row" onclick="selectSource('osmfr-v1')">
            <text class="label">OSM 法国社区</text>
            <text class="value" style="color: {{sourceId === 'osmfr-v1' ? '#7fd6e4' : '#8ba0a8'}};">{{sourceId === 'osmfr-v1' ? '使用中' : '切换'}}</text>
          </div>
          <div class="divider"></div>
          <div class="row" onclick="selectSource('osm-standard-v1')">
            <text class="label">OSM 标准</text>
            <text class="value" style="color: {{sourceId === 'osm-standard-v1' ? '#7fd6e4' : '#8ba0a8'}};">{{sourceId === 'osm-standard-v1' ? '使用中' : '切换'}}</text>
          </div>
          <div class="divider"></div>
          <div class="row" onclick="selectSource('tianditu-v1')">
            <text class="label">天地图</text>
            <text class="value" style="color: {{sourceId === 'tianditu-v1' ? '#7fd6e4' : '#8ba0a8'}};">{{sourceId === 'tianditu-v1' ? '使用中' : '切换'}}</text>
          </div>
          <div if="{{previousSourceId !== '' && previousSourceId !== sourceId}}" class="divider"></div>
          <div if="{{previousSourceId !== '' && previousSourceId !== sourceId}}" class="row" onclick="usePrevious">
            <text class="label">切回上次使用</text>
            <text class="value" style="color: #8ba0a8;">{{previousName}}</text>
          </div>
        </div>

        <text class="section">显示</text>
        <div class="card">
          <div class="row" onclick="toggleStatus">
            <text class="label">顶部状态信息</text>
            <text class="value" style="color: {{showStatus ? '#7fd6e4' : '#8ba0a8'}};">{{showStatus ? '开启' : '关闭'}}</text>
          </div>
          <div class="divider"></div>
          <div class="row" onclick="toggleBottomHint">
            <text class="label">底部图源署名</text>
            <text class="value" style="color: {{hideBottomHint ? '#8ba0a8' : '#7fd6e4'}};">{{hideBottomHint ? '隐藏' : '显示'}}</text>
          </div>
          <div class="divider"></div>
          <div class="row" onclick="toggleLoading">
            <text class="label">瓦片加载动画</text>
            <text class="value" style="color: {{showLoadingIndicators ? '#7fd6e4' : '#8ba0a8'}};">{{showLoadingIndicators ? '开启' : '关闭'}}</text>
          </div>
        </div>

        <text class="section">应用</text>
        <div class="card">
          <div class="row" onclick="exitApp">
            <text class="label label-danger">退出应用</text>
            <text class="value" style="color: #8ba0a8;">关闭地图</text>
          </div>
        </div>

        <text class="hint">{{saveStatus}}</text>
        <text class="hint">地图页已拦截右滑返回，退出请到这里</text>
      </div>
    </scroll>
  </div>
</template>
<script>
import router from '@system.router'
import storage from '@system.storage'
import brightness from '@system.brightness'
import Preferences from '../../common/map/preferences'
import Providers from '../../common/map/providers'
export default {
  private: {
    sourceId: 'osmfr-v1', previousSourceId: '', previousName: '',
    hideBottomHint: false, showLoadingIndicators: true, showStatus: true,
    ready: false, saving: false, saveStatus: '正在读取设置', disposed: false
  },
  onReady() {
    var self = this
    Preferences.load(storage, function (value) {
      if (self.disposed) return
      self.applyValues(value)
      self.ready = true
      self.saveStatus = '更改自动保存'
    })
  },
  onShow() { this.keepAwake(true) },
  onHide() { this.keepAwake(false) },
  onDestroy() { this.disposed = true; this.keepAwake(false) },
  keepAwake(value) {
    try { brightness.setKeepScreenOn({ keepScreenOn: value }) } catch (ignored) {}
  },
  applyValues(value) {
    this.sourceId = value.sourceId
    this.previousSourceId = value.previousSourceId
    this.previousName = value.previousSourceId ? Providers.get(value.previousSourceId).name : ''
    this.hideBottomHint = value.hideBottomHint
    this.showLoadingIndicators = value.showLoadingIndicators
    this.showStatus = value.showStatus
  },
  currentValues() {
    return { sourceId: this.sourceId, previousSourceId: this.previousSourceId, hideBottomHint: this.hideBottomHint, showLoadingIndicators: this.showLoadingIndicators, showStatus: this.showStatus }
  },
  persist(value) {
    if (!this.ready || this.saving) return
    this.saving = true
    this.saveStatus = '正在保存'
    var self = this
    Preferences.save(storage, value, function () {
      if (self.disposed) return
      self.applyValues(value)
      self.saving = false
      self.saveStatus = '已保存'
    }, function () {
      if (self.disposed) return
      self.saving = false
      self.saveStatus = '保存失败，请重试'
    })
  },
  selectSource(id) {
    if (!this.ready || this.saving || id === this.sourceId) return
    var value = this.currentValues()
    value.previousSourceId = value.sourceId
    value.sourceId = Providers.get(id).id
    this.persist(value)
  },
  usePrevious() { if (this.previousSourceId) this.selectSource(this.previousSourceId) },
  toggleStatus() { var value = this.currentValues(); value.showStatus = !value.showStatus; this.persist(value) },
  toggleBottomHint() { var value = this.currentValues(); value.hideBottomHint = !value.hideBottomHint; this.persist(value) },
  toggleLoading() { var value = this.currentValues(); value.showLoadingIndicators = !value.showLoadingIndicators; this.persist(value) },
  goBack() { if (!this.saving) router.back() },
  exitApp() {
    try { this.$app.exit() } catch (error) { router.back() }
  }
}
</script>
<style>
.settings-root { width: 100%; height: 100%; background-color: #0d1518; }
.settings-scroll { width: 100%; height: 100%; }
.settings-body { width: 100%; flex-direction: column; padding: 26px 22px 40px 22px; }
.back { height: 44px; width: 100%; justify-content: flex-start; }
.back-text { color: #7fd6e4; font-size: 18px; }
.title { color: #ffffff; font-size: 30px; text-align: center; margin-bottom: 20px; }
.section { color: #6d838c; font-size: 15px; margin: 14px 6px 10px 6px; }
.card { width: 100%; border-radius: 24px; background-color: #17242a; flex-direction: column; }
.row { height: 68px; width: 100%; padding-left: 18px; padding-right: 18px; align-items: center; justify-content: space-between; }
.label { color: #ffffff; font-size: 19px; }
.label-danger { color: #ff8a80; }
.value { font-size: 16px; }
.divider { height: 1px; background-color: #24343b; margin-left: 18px; margin-right: 18px; }
.hint { color: #5f757e; font-size: 14px; text-align: center; margin-top: 12px; }
</style>
